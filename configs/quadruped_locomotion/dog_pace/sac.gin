# Basic configuration
train_func.task_name = "dog_pace"
train_func.algorithm = "sac"
train_func.seed = 42
train_func.debug = False

# Environment configuration
train_func.env_name = "QuadrupedLocomotion-DogPace-v0"

# Training hyperparameters
train_func.num_iterations = 1000
train_func.batch_size = 256
train_func.learning_rate = 3e-4

# Logging and checkpointing
train_func.eval_interval = 1
train_func.log_interval = 1
train_func.train_checkpoint_interval = 10
train_func.policy_checkpoint_interval = 10

# Distributed training
train_func.num_replicas = 1
train_func.num_collect_jobs = 11
train_func.env_batch_size = 11

# Distributed training configurations
train_func.replay_buffer_server_address = "127.0.0.1"
train_func.variable_container_server_address = "127.0.0.1"
train_func.replay_buffer_server_port = 8008
train_func.variable_container_server_port = 8008

# SAC configuration
train_func.max_sequence_length = 100
train_func.replay_buffer_capacity = 2000000  # Updated as per SAC hyperparameters
