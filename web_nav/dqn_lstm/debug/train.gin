train_eval.collect_steps_per_iteration = 1
train_eval.summaries_flush_secs = 10
train_eval.env_name = 'WebNavigation-v0'
#train_eval.env_args = {'designs':[{'number_of_pages': 1, 'action': [],'action_page': [],}]}
train_eval.env_args = {}
train_eval.use_gpu = True
#train_eval.initial_collect_steps = 1000
train_eval.initial_collect_steps = 5
train_eval.epsilon_greedy = 0.05
train_eval.target_update_tau = 0.05
train_eval.target_update_period = 5000
train_eval.batch_size = 32
train_eval.learning_rate = 1e-4
train_eval.n_step_update = 1
train_eval.gamma = 0.99
train_eval.reward_scale_factor = 1.0
train_eval.gradient_clipping = None
train_eval.use_tf_functions = True
train_eval.num_eval_episodes = 10
train_eval.debug_summaries = False
train_eval.summarize_grads_and_vars = True
train_eval.eval_metrics_callback = None
train_eval.max_vocab_size = 500

